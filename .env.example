# --- Supabase, проект brasil-products -------------------------------------
# Строка пулера со страницы Database, роль dailynews_bot.
# Прямой хост db.<ref>.supabase.co только по IPv6 — ни Vercel, ни GitHub
# Actions по нему не ходят, и симптом выглядит как неверный пароль.
DATABASE_URL=

# --- Скоринг ---------------------------------------------------------------
# TypeSafe Jev: восемь типизированных вопросов на каждый материал потока.
TYPESAFE_API_KEY=

# --- Дайджест --------------------------------------------------------------
# Любой OpenAI-совместимый провайдер. Модель видит только выживших.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash

# --- Бот -------------------------------------------------------------------
# Один токен на один процесс: поллинга здесь нет, апдейты приходят вебхуком.
TELEGRAM_BOT_TOKEN=
# Случайная строка. Ею подписан каждый запрос Telegram к /api/telegram:
# адрес открыт всему интернету, и это единственное, что отличает Telegram
# от постороннего. Ставится вместе с вебхуком: npm run bot:webhook
TELEGRAM_WEBHOOK_SECRET=
# Имя бота без @. Нужно только кнопке на странице входа; выдуманное имя
# увело бы читателя к чужому боту.
TELEGRAM_BOT_USERNAME=
# Второй бот: в него владелец бросает ссылку, ролик, чужой пост или мысль
# и получает черновики постов своим голосом (/api/postbot). Токен берётся
# у @BotFather так же, как первый; секрет — случайная строка, ставится
# вместе с вебхуком: npm run postbot:webhook. Отвечает он только на
# TELEGRAM_CHAT_ID ниже, и незаданный номер означает «никому».
POSTBOT_TOKEN=
POSTBOT_WEBHOOK_SECRET=
# Telegram-id владельца. Нужен один раз: по нему строка, перенесённая
# из profile, достаётся тому, чья она, а не первому написавшему /start.
TELEGRAM_CHAT_ID=
# Канал, на который зовём перед входом: @имя, имя или ссылка t.me.
# Бот обязан быть его администратором — иначе getChatMember не отвечает,
# и отличить «не подписан» от «бот не админ» снаружи нечем.
#
# Пусто — гейта нет вовсе. Здесь это не секрет, а настройка роста: первый
# же деплой без переменной закрыл бы вход всем новым читателям, и выглядело
# бы это как поломка бота. А вот ошибка проверки вход не открывает.
TELEGRAM_CHANNEL=

# --- Kindle ----------------------------------------------------------------
# Resend, домен kindle.reporta.club. Обратный адрес свой у каждого читателя:
# Amazon считает объём по отправителю, и общий адрес отваливается разом
# у всех. Без ключа выпуск просто не уходит на читалку.
RESEND_API_KEY=

# --- Цена моделей ----------------------------------------------------------
# $ за миллион токенов той модели, что стоит в LLM_MODEL. Нужны дневному
# потолку на читателя: без верной цены событие о расходе — выдумка.
# Пустая строка — это «не задано», а не ноль: подставится цена
# gemini-2.5-flash (0.30 / 2.50), и расход окажется завышен.
# deepseek-flash (DeepSeek V4.1 Flash, вне пика): 0.15 / 0.003 / 0.60.
LLM_INPUT_PRICE=0.15
LLM_CACHE_INPUT_PRICE=0.003
LLM_OUTPUT_PRICE=0.60

# --- Источники, требующие ключей -------------------------------------------
# Reddit: бесплатно, reddit.com/prefs/apps, тип script.
# Без ключей анонимные запросы получают 429 уже на втором сабреддите.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# X: платно, около $0.15 за 1000 постов (twitterapi.io).
X_API_KEY=

# Почта: выделенный ящик, куда подписаны рассылки. Только imaps://.
# Пароль в строке кодируется процентами, если в нём есть : / @ или #.
# Прогон только читает: письма забираются BODY.PEEK и не помечаются
# прочитанными. Входящего эндпоинта нет — на общей машине лишнего
# наружу быть не должно.
IMAP_URL=
# Папка, если рассылки раскладываются фильтром. По умолчанию INBOX.
IMAP_FOLDER=

# --- Приложение ------------------------------------------------------------
# Адрес развёрнутого интерфейса. Без него уведомление отправлено не будет:
# выдуманный домен почти наверняка занят чужим сайтом, и ссылка «Читать»
# уведёт читателя туда.
APP_URL=
# Вход через Google. Не заданы — кнопки на странице входа нет.
# Redirect URI в Google Cloud: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Случайная строка от 16 символов: ею подписываются кука сессии и ссылка
# входа. Обе несут номер читателя внутри подписи — иначе подпись от чужой
# куки годилась бы с подменённым номером.
APP_SECRET=

# Brand rollout: off | owner | all | readers:1,2
REPORTA_BRAND_COLORS_V2=off

# --- Миграции --------------------------------------------------------------
# Владельческая строка: Supabase → Settings → Database → Session pooler,
# роль postgres. Её берёт `npm run migrate` — роль приложения намеренно
# не владелец таблиц, и DDL ей запрещён. В CI и в образ не уезжает:
# она достаёт и соседние продукты общей базы. Без неё миграции выглядят
# как «нет доступа», хотя доступ есть — просто не подцепился .env.
SUPABASE_DB_URL=

# --- Отправка на Kindle ----------------------------------------------------
RESEND_API_KEY=
# Домен обратного адреса для отправки на Kindle.
KINDLE_FROM_DOMAIN=

# --- Оплата, Paddle ----------------------------------------------------------
# sandbox или production. Sandbox и боевой — разные аккаунты Paddle со своими
# ключами, ценами и секретами: переезд — смена всех значений ниже разом.
PADDLE_ENV=sandbox
# Серверный ключ (pdl_sdbx_apikey_… / pdl_live_apikey_…): портал клиента.
PADDLE_API_KEY=
# Клиентский токен (test_… / live_…) для окна оплаты Paddle.js. Не секрет,
# но без него кнопки «Выбрать» не появляются.
PADDLE_CLIENT_TOKEN=
# Секрет адреса уведомлений (pdl_ntfset_…): им подписано каждое событие.
# Пусто — вебхук отвергает всё: иначе забытая переменная превращает смену
# тарифа в публичный эндпоинт.
PADDLE_WEBHOOK_SECRET=
# id цен подписки (pri_…). Цена приходит в вебхуке и превращается в тариф.
PADDLE_PRICE_PLUS=
PADDLE_PRICE_PRO=
