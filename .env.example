# --- Supabase, проект brasil-products -------------------------------------
# Строка пулера со страницы Database, роль dailynews_bot.
# Прямой хост db.<ref>.supabase.co только по IPv6 — ни Vercel, ни GitHub
# Actions по нему не ходят, и симптом выглядит как неверный пароль.
DATABASE_URL=

# --- Скоринг ---------------------------------------------------------------
# TypeSafe Jev: восемь типизированных вопросов на каждый материал потока.
TYPESAFE_API_KEY=

# --- Дайджест --------------------------------------------------------------
# Любой OpenAI-совместимый провайдер. Модель видит только выживших.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash

# --- Бот -------------------------------------------------------------------
# Один токен на один процесс: поллинга здесь нет, апдейты приходят вебхуком.
TELEGRAM_BOT_TOKEN=
# Случайная строка. Ею подписан каждый запрос Telegram к /api/telegram:
# адрес открыт всему интернету, и это единственное, что отличает Telegram
# от постороннего. Ставится вместе с вебхуком: npm run bot:webhook
TELEGRAM_WEBHOOK_SECRET=
# Имя бота без @. Нужно только кнопке на странице входа; выдуманное имя
# увело бы читателя к чужому боту.
TELEGRAM_BOT_USERNAME=
# Telegram-id владельца. Нужен один раз: по нему строка, перенесённая
# из profile, достаётся тому, чья она, а не первому написавшему /start.
TELEGRAM_CHAT_ID=

# --- Kindle ----------------------------------------------------------------
# Resend, домен kindle.tomko.io. Обратный адрес свой у каждого читателя:
# Amazon считает объём по отправителю, и общий адрес отваливается разом
# у всех. Без ключа выпуск просто не уходит на читалку.
RESEND_API_KEY=

# --- Цена моделей ----------------------------------------------------------
# $ за миллион токенов. Нужны дневному потолку на читателя: без верной
# цены событие о расходе — выдумка. По умолчанию — gemini-2.5-flash.
LLM_INPUT_PRICE=0.30
LLM_OUTPUT_PRICE=2.50

# --- Источники, требующие ключей -------------------------------------------
# Reddit: бесплатно, reddit.com/prefs/apps, тип script.
# Без ключей анонимные запросы получают 429 уже на втором сабреддите.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# X: платно, около $0.15 за 1000 постов (twitterapi.io).
X_API_KEY=

# --- Приложение ------------------------------------------------------------
# Адрес развёрнутого интерфейса. Без него уведомление отправлено не будет:
# выдуманный домен почти наверняка занят чужим сайтом, и ссылка «Читать»
# уведёт читателя туда.
APP_URL=
# Запасной вход владельца. Читатели входят ссылкой из бота.
APP_PASSWORD=
# Случайная строка от 16 символов: ею подписываются кука сессии и ссылка
# входа. Обе несут номер читателя внутри подписи — иначе подпись от чужой
# куки годилась бы с подменённым номером.
APP_SECRET=
