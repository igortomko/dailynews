news.reporta.club {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Лента личная и в поиске ей делать нечего.
		X-Robots-Tag "noindex, nofollow"
	}

	handle /_next/static/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy 127.0.0.1:8085
	}

	reverse_proxy 127.0.0.1:8085
}

# Лендинга ещё нет: корень ведёт в ленту. 302, а не 301 — постоянный
# редирект браузер запоминает, и лендинг потом не увидели бы те, кто уже заходил.
reporta.club, www.reporta.club {
	redir https://news.reporta.club{uri} 302
}

# Старый адрес живёт в уже отправленных сообщениях бота и в закладках.
news.tomko.io {
	redir https://news.reporta.club{uri} 301
}
